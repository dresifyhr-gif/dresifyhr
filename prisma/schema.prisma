// Dresify internal DB — orders/customers/products for the admin dashboard + AI.
// The public shop keeps working exactly as before; this data layer is additive.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Order {
  id           String      @id @default(cuid())
  reference    String?     // e.g. DRS-260629-0909
  createdAt    DateTime    @default(now())

  customerName String
  phone        String?
  email        String?
  address      String?

  channel      String      @default("web")
  fulfillment  String?
  payment      String?

  subtotal     Float       @default(0)
  shipping     Float       @default(0)
  discount     Float       @default(0)
  total        Float       @default(0)
  promoCode    String?
  note         String?
  itemCount    Int         @default(0)

  status       String      @default("new") // new | shipped | done | returned | cancelled
  shippedBy    String?     // "igor" | "ivica" — tko je fizički poslao (za obračun)
  shippedAt    DateTime?
  tracking     String?     // broj pošiljke / tracking
  apologySent  Boolean     @default(false) // označeno da je isprika poslana (miče iz win-back liste)
  cashCollected   Boolean   @default(false) // pouzeće: novci prikupljeni (poštar predao). Prikupio = shippedBy.
  cashCollectedAt DateTime?

  items        OrderItem[]
  customer     Customer?   @relation(fields: [customerId], references: [id])
  customerId   String?

  @@index([createdAt])
  @@index([status])
  @@index([shippedBy])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String

  slug      String?
  klub      String?
  igrac     String?
  size      String?
  segment   String? // adult | kid
  quantity  Int     @default(1)
  unitPrice Float   @default(0)

  @@index([orderId])
  @@index([slug])
}

model Customer {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?
  name         String?
  address      String?

  firstOrderAt DateTime @default(now())
  lastOrderAt  DateTime @default(now())
  totalOrders  Int      @default(0)
  totalSpent   Float    @default(0)

  orders       Order[]
}

// Product cost (nabavna cijena) for margin/profit; mirrors the catalog by slug.
model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  klub      String
  igrac     String
  liga      String?
  price     Float    @default(20)
  cost      Float    @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Override kataloga iz admina (bez diranja koda): cijena + zaliha po slugu.
// Ako postoji redak za slug, njegove vrijednosti gaze osnovni katalog.
model ProductOverride {
  slug         String   @id
  // Uređivanje osnovnih podataka i slika za dresove iz statičkog kataloga
  // (custom proizvodi to imaju na svom CustomProduct retku). Prazno = ostaje original.
  klub         String?
  igrac        String?
  liga         String?
  images       String? // JSON niz URL-ova; prazno = originalne slike iz /public
  price        Float?
  stock        Int? // ručno postavljena ukupna količina (prazno = automatska); ako ima sizeStock, računa se zbroj
  sizeStock    String? // JSON količina po veličini, npr. {"S":3,"M":5,"L":0}; 0 = rasprodana veličina
  outOfStock   String? // "all" | "adults" | "kids" (prazno = na stanju)
  soldOutSizes String? // npr. "XL,XXL"
  hidden       Boolean  @default(false) // draft/sakriveno — ne prikazuje se na shopu
  badge        String? // "bestseller" | "novo" | "" (prazno = bez)
  featured     Boolean  @default(false) // ručno odabran za "Najprodavaniji dresovi" na naslovnici
  description  String? // vlastiti opis (paragrafi odvojeni novim redom); prazno = auto
  updatedAt    DateTime @updatedAt
}

// Recenzije / zadovoljni kupci — slike koje su kupci slali (IG/WhatsApp), prikaz na shopu.
model Testimonial {
  id        String   @id @default(cuid())
  imageUrl  String
  name      String?
  text      String?
  hidden    Boolean  @default(false)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([hidden, sort])
}

// Novi dresovi dodani kroz admin (ne postoje u kodu). Shop ih čita uz osnovni katalog.
model CustomProduct {
  id           String   @id @default(cuid())
  slug         String   @unique
  category     String   @default("dres") // "dres" | "streetwear"
  klub         String
  igrac        String
  liga         String   @default("Reprezentacija")
  price        Float    @default(20)
  retro        Boolean  @default(false)
  vel          String   @default("Djeca: 104-176 · Odrasli: S-XXL")
  badge        String?
  featured     Boolean  @default(false) // ručno odabran za "Najprodavaniji dresovi" na naslovnici
  stock        Int? // ručno postavljena ukupna količina (prazno = automatska); ako ima sizeStock, računa se zbroj
  sizeStock    String? // JSON količina po veličini, npr. {"S":3,"M":5,"L":0}; 0 = rasprodana veličina
  outOfStock   String?
  soldOutSizes String?
  description  String?
  images       String   @default("[]") // JSON niz URL-ova slika (redoslijed = galerija)
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Poravnanje računa Igor ↔ Ivica. Nakon poravnanja podjela broji samo profit
// od zadnjeg settledAt nadalje.
model Settlement {
  id          String   @id @default(cuid())
  settledAt   DateTime @default(now())
  amount      Float    @default(0) // koliko je prebačeno
  fromPartner String? // "igor" | "ivica" — tko je platio
  igorProfit  Float    @default(0) // snapshot na trenutak poravnanja
  ivicaProfit Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())

  @@index([settledAt])
}

// Ad spend entries for ROI (Instagram/Facebook marketing).
model AdSpend {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  @@index([date])
}

// Postavke shopa — jedan redak (id="singleton"). Uređuje se u adminu (Postavke),
// pa se cijene/adrese mijenjaju bez diranja koda. Prazno/null = koristi default iz lib/site.ts.
model Settings {
  id                  String   @id @default("singleton")
  // Dostava i naplata
  shippingPrice       Float?   // ukupna cijena dostave kupcu (npr. 7)
  freeShipThreshold   Float?   // roba ≥ ovoga = besplatna dostava (npr. 60)
  // Nabava (za profit/poravnanje)
  costDres            Float?   // nabavna cijena dresa (npr. 6)
  costKomplet         Float?   // nabavna cijena kompleta (npr. 18)
  costStreetwear      Float?   // nabavna cijena streetwear kompleta (prodaja 50 €)
  // Poslovna pravila (samo admin/obračun — ne diraju blagajnu)
  deliveryCost        Float?   // koliko NAS košta besplatna dostava (skida se s marže)
  returnCost          Float?   // koliko NAS košta vraćena pošiljka
  igorSharePct        Float?   // Igorov udio u marži u % (50 = pola-pola)
  winbackDays         Int?     // koliko dana bez kupnje = "vrati kupca"
  riskMinFailed       Int?     // od koliko odbijanja kupac postaje "rizičan"
  // Pošiljatelji (naljepnice)
  igorName            String?
  igorAddress         String?
  igorCity            String?
  ivicaName           String?
  ivicaAddress        String?
  ivicaCity           String?
  // Posao (naljepnice / budući računi)
  iban                String?
  businessName        String?
  // Brend / kontakt (vidljivo na shopu)
  whatsappNumber      String?  // samo znamenke, npr. 385976047510
  instagramHandle     String?  // npr. dresify.hr (bez @)
  // Operativa
  leagues             String?  // JSON niz liga za forme proizvoda
  notifyEmail         Boolean? // šalji obavijest o narudžbi na email
  notifyTelegram      Boolean?
  notifyWhatsapp      Boolean?
  // Izgled shopa
  announcementActive  Boolean? // traka obavijesti na vrhu
  announcementText    String?  // prazno = zadane poruke iz prijevoda
  heroTitle           String?  // prazno = zadani naslov
  heroSubtitle        String?
  hiddenSections      String?  // JSON niz ključeva sekcija koje se NE prikazuju
  accentColor         String?  // npr. #e8ff3c
  // Dresify Klub (vjernost po telefonu)
  klubActive          Boolean? // uključen program vjernosti
  klubTarget          Int?     // koliko PREUZETIH narudžbi do nagrade (npr. 3)
  klubRewardKind      String?  // "percent" | "freeship" (gratis dres = percent 100 na 1 dres → koristimo fiksni popust)
  klubRewardValue     Float?   // postotak ili iznos popusta
  klubRewardLabel     String?  // opis nagrade koji vidi kupac
  contactPhone        String?
  contactEmail        String?
  updatedAt           DateTime @updatedAt
}

// Popust-kodovi — uređuju se u adminu (prije su bili zakucani u lib/promo.ts).
// Broj iskorištenja se NE sprema ovdje nego se izvodi iz Order.promoCode (uvijek točan).
model PromoCode {
  code        String    @id // npr. "DRESIFY10" (uvijek velikim slovima)
  kind        String    @default("percent") // "percent" | "freeship"
  value       Float     @default(0) // postotak popusta (0 za besplatnu dostavu)
  minSubtotal Float     @default(0) // minimalna vrijednost robe (bez dostave)
  label       String    @default("") // kratki opis koji vidi kupac
  active      Boolean   @default(true)
  expiresAt   DateTime? // prazno = bez roka
  maxUses     Int? // prazno = neograničeno
  note        String? // interna bilješka (odakle kod, kampanja)
  source      String? // "manual" | "klub" | "kolo" — tko je izdao kod
  personalFor String? // phoneKey kupca kojem je kod izdan (osobne nagrade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}
